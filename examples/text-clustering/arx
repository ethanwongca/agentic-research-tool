#!/usr/bin/env bash
# arx launcher (generated by `arx init`). Uses the installed `arx` command
# (pip install -e <path to agentic-research-tool>); set ARX_PYTHON to pick a specific interpreter.
if [ -z "$ARX_PYTHON" ] && command -v arx >/dev/null 2>&1; then exec arx "$@"; fi
exec "${ARX_PYTHON:-python3}" -m arx "$@"
