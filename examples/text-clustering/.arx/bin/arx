#!/usr/bin/env bash
# Called by the Claude Code hooks (generated by `arx init`).
if [ -n "$ARX_PYTHON" ]; then exec "$ARX_PYTHON" -m arx "$@"; fi
if command -v arx >/dev/null 2>&1; then exec arx "$@"; fi
if python3 -c "import arx.cli" 2>/dev/null; then exec python3 -m arx "$@"; fi
echo "arx is not installed in this environment (pip install -e <agentic-research-tool>), so the gate cannot check this action. Refusing it. Activate the env with arx, or ask the researcher." >&2
if [ "$2" = "pre-tool-use" ]; then exit 2; fi
exit 0
